{
  "$schema": "https://zed.dev/schema/settings.json",
  "theme": {
    "mode": "system",
    "light": "Vercel Light",
    "dark": "Vercel Dark"
  },
  "icon_theme": {
    "mode": "system",
    "light": "Light Charmed Icons",
    "dark": "VSCode Great Icons Theme"
  },
  "auto_install_extensions": {
    "vercel-theme": true,
    "charmed-icons": true,
    "vscode-great-icons": true
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "cli_default_open_behavior": "new_window",
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "project_panel": {
    "dock": "left",
    "hide_hidden": false
  },
  "inlay_hints": {
    "enabled": false
  },
  "lsp": {
    "vtsls": {
      "settings": {
        "javascript": {
          "inlayHints": {
            "variableTypes": {
              "enabled": false
            },
            "parameterTypes": {
              "enabled": false
            },
            "functionLikeReturnTypes": {
              "enabled": false
            },
            "propertyDeclarationTypes": {
              "enabled": false
            },
            "enumMemberValues": {
              "enabled": false
            },
            "parameterNames": {
              "enabled": false
            }
          }
        },
        "typescript": {
          "inlayHints": {
            "variableTypes": {
              "enabled": false
            },
            "parameterTypes": {
              "enabled": false
            },
            "functionLikeReturnTypes": {
              "enabled": false
            },
            "propertyDeclarationTypes": {
              "enabled": false
            },
            "enumMemberValues": {
              "enabled": false
            },
            "parameterNames": {
              "enabled": false
            }
          }
        }
      }
    }
  },
  "disable_ai": false,
  "minimap": {
    "show": "never"
  },
  "format_on_save": "off",
  "buffer_font_family": "JetBrainsMonoNL Nerd Font Mono",
  "ui_font_family": "JetBrainsMonoNL Nerd Font Mono",
  "ui_font_size": 15,
  "buffer_font_size": 15
}
